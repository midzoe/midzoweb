# URL de l'API (backend Next.js `midzobackend`).
# Par défaut : backend hébergé (joignable aussi depuis le front lancé en local).
# Backend local (midzobackend, `npm run dev`) : http://localhost:3000/api
VITE_API_URL=https://midzobackend.vercel.app/api

# EmailJS (facultatif)
VITE_EMAILJS_SERVICE_ID=service_placeholder
VITE_EMAILJS_TEMPLATE_ID=template_placeholder
VITE_EMAILJS_PUBLIC_KEY=public_key_placeholder
