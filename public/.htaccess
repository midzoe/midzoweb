# Hébergement Apache (o2switch) : application React à une seule page.
# Toute URL qui n'est pas un fichier réel (/study, /payment/success, /verify-email…)
# renvoie index.html, et React Router affiche la bonne page. Sans ce fichier, un lien
# ouvert directement (retour Stripe, lien d'email, actualisation) donne une erreur 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html jamais en cache : après chaque mise en ligne, le navigateur charge les
# nouveaux fichiers /assets (leur nom change à chaque build, eux peuvent rester en cache).
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
